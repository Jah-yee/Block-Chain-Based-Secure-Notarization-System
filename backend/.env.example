# BBSNS Environment Variables (Reference Only)
# 🚨 IMPORTANT: DO NOT USE A .env FILE FOR SECRETS.
# Set these as SYSTEM environment variables on your machine.

# Required System Variables:
# -------------------------
# JWT_SECRET=your_strong_secret_hex_at_least_32_bytes
# DB_PASSWORD=your_strong_db_password
# BNB_RELAYER_PRIVATE_KEY=your_restricted_relayer_private_key
# HASH_SALT=your_unique_hash_salt_for_national_id

# Optional / Default Configuration (Can be set as system vars):
PORT=5000
NODE_ENV=development

# Database Configuration (Host/Port/Name/User)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=notarydb
DB_USER=bbsns_user

# Blockchain Contract Addresses
BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
NTK_CONTRACT_ADDRESS=your_ntk_contract_address
NTKR_CONTRACT_ADDRESS=your_ntkr_contract_address
DOCUMENT_REGISTRY_ADDRESS=your_document_registry_address

# REMOVED PERMANENTLY:
# BNB_SYSTEM_PRIVATE_KEY
